# Relaybase local environment.
# Copy this file to .env and fill in values locally. The real .env file is ignored by git.

# Legacy compatibility only. The intended Windows path is:
# /settings -> Agent -> Provider -> Connect OpenRouter.
# If used temporarily, create a Relaybase-only key with a spending limit and expiration,
# migrate it to Windows DPAPI, verify the managed connection, then remove this value manually.
OPENROUTER_API_KEY=
# Non-secret Agent settings may remain here for developer workflows.
RELAYBASE_AGENT_MODEL=
RELAYBASE_AGENT_ENABLED=0
RELAYBASE_AGENT_REMOTE_MODEL_ENABLED=0

# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=Relaybase Local

# Optional Relaybase daemon defaults.
RELAYBASE_HOST=127.0.0.1
RELAYBASE_PORT=7777
