{
  "name": "@cameloo/relaybase",
  "version": "0.1.0",
  "description": "Local-first MCP router and lifecycle hub for AI-agent-built apps.",
  "type": "module",
  "bin": {
    "relaybase": "./bin/relaybase.cjs"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "examples/",
    "skills/"
  ],
  "scripts": {
    "serve": "node --experimental-strip-types src/cli.ts serve",
    "relaybase": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint .",
    "format": "prettier --write package.json .prettierrc.json eslint.config.mjs jest.config.mjs \"*.md\" \"docs/**/*.md\" \"skills/**/*.md\" \"examples/**/*.json\" \".github/**/*.{yml,yaml}\" \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/fixtures/**/*.cjs\"",
    "format:check": "prettier --check package.json .prettierrc.json eslint.config.mjs jest.config.mjs \"*.md\" \"docs/**/*.md\" \"skills/**/*.md\" \"examples/**/*.json\" \".github/**/*.{yml,yaml}\" \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/fixtures/**/*.cjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs",
    "smoke": "node --experimental-strip-types src/cli.ts health",
    "package:check": "npm pack --dry-run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:jest && npm run smoke"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "ports",
    "proxy",
    "routing",
    "localhost",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
