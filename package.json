{
  "name": "@cameloo/relaybase",
  "version": "0.1.0",
  "description": "Local-first MCP router and lifecycle hub for AI-agent-built apps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cameloo1/relaybase.git"
  },
  "homepage": "https://github.com/Cameloo1/relaybase#readme",
  "bugs": {
    "url": "https://github.com/Cameloo1/relaybase/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "relaybase": "./bin/relaybase.cjs"
  },
  "files": [
    "CHANGELOG.md",
    "SECURITY.md",
    ".codex-plugin/",
    ".mcp.json",
    "bin/relaybase.cjs",
    "dist-runtime/",
    "docs/**/*.md",
    "!docs/relaybase-release-roadmap.md",
    "!docs/tui-setup-gap-map.md",
    "docs/relaybase-title.png",
    "examples/",
    "skills/"
  ],
  "scripts": {
    "start": "node scripts/relaybase-start.mjs",
    "build:runtime": "tsc -p tsconfig.build.json",
    "prepack": "npm run build:runtime",
    "serve": "node --experimental-strip-types src/cli.ts serve",
    "relaybase": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint .",
    "format": "prettier --write package.json .prettierrc.json eslint.config.mjs jest.config.mjs .goreleaser.yml \"*.md\" \"docs/**/*.md\" \"skills/**/*.md\" \"examples/**/*.json\" \".github/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/fixtures/**/*.cjs\"",
    "format:check": "prettier --check package.json .prettierrc.json eslint.config.mjs jest.config.mjs .goreleaser.yml \"*.md\" \"docs/**/*.md\" \"skills/**/*.md\" \"examples/**/*.json\" \".github/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/fixtures/**/*.cjs\"",
    "docs:check": "node scripts/check-doc-links.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs",
    "tui:build": "node scripts/tui-go.mjs build",
    "tui:build:all": "node scripts/tui-go.mjs build --all",
    "tui:test": "node scripts/tui-go.mjs test",
    "tui:vet": "node scripts/tui-go.mjs vet",
    "tui:race": "node scripts/tui-go.mjs race",
    "tui:snapshot": "node scripts/tui-go.mjs snapshot",
    "tui:smoke": "node --experimental-strip-types scripts/tui-smoke.mjs --artifact-dir artifacts/tui-verification/default",
    "tui:smoke:8pane": "node --experimental-strip-types scripts/tui-smoke.mjs --fixture 8pane --artifact-dir artifacts/tui-verification/8pane",
    "tui:doctor": "node scripts/tui-go.mjs doctor",
    "doctor:tui": "node scripts/tui-go.mjs doctor",
    "doctor": "npm run doctor:tui",
    "agent:smoke:openrouter": "node --experimental-strip-types src/cli.ts agent smoke-openrouter",
    "agent:live:acceptance": "node --experimental-strip-types src/cli.ts agent live-acceptance",
    "agent:live:command-matrix": "node --experimental-strip-types src/cli.ts agent live-command-matrix",
    "agent:live:folder-start": "node --experimental-strip-types src/cli.ts agent live-folder-start",
    "agent:threads:evidence": "node --experimental-strip-types scripts/agent-threads-evidence.mjs",
    "agent-tui:inventory": "node --experimental-strip-types scripts/agent-tui-inventory.mjs",
    "agent:test": "node --experimental-strip-types --test tests/agent-*.test.ts",
    "release:check": "node scripts/tui-go.mjs release-check",
    "release:dry-run": "node scripts/tui-go.mjs release-dry-run",
    "check": "node --experimental-strip-types src/cli.ts check",
    "smoke": "node --experimental-strip-types src/cli.ts health",
    "package:check": "node scripts/package-check.mjs",
    "package:prepare-platforms": "node scripts/prepare-platform-packages.mjs",
    "package:check-platforms": "node scripts/platform-package-check.mjs",
    "package:install-smoke": "node scripts/package-install-smoke.mjs",
    "package:check:strict": "node scripts/package-check.mjs --require-tui-binary",
    "verify:clean-worktree": "node scripts/check-worktree-clean.mjs",
    "verify:clean-worktree:allow-reports": "node scripts/check-worktree-clean.mjs --allow-reports",
    "verify:workspace:before": "node scripts/check-worktree-clean.mjs --write-status artifacts/workspace-status-before.json",
    "verify:workspace:after": "node scripts/check-worktree-clean.mjs --write-status artifacts/workspace-status-after.json",
    "verify": "node --experimental-strip-types src/cli.ts verify"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "ports",
    "proxy",
    "routing",
    "localhost",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.11.6",
    "openai": "^6.41.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@cameloo/relaybase-tui-darwin-amd64": "0.1.0",
    "@cameloo/relaybase-tui-darwin-arm64": "0.1.0",
    "@cameloo/relaybase-tui-linux-amd64": "0.1.0",
    "@cameloo/relaybase-tui-linux-arm64": "0.1.0",
    "@cameloo/relaybase-tui-windows-amd64": "0.1.0",
    "@cameloo/relaybase-tui-windows-arm64": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
