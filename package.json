{
  "name": "porthub",
  "version": "0.1.0",
  "description": "Local-first routing hub for AI-agent-built apps and crowded dev ports.",
  "type": "module",
  "bin": {
    "porthub": "./bin/porthub.cjs"
  },
  "scripts": {
    "serve": "node --experimental-strip-types src/cli.ts serve",
    "porthub": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "smoke": "node --experimental-strip-types src/cli.ts status"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "ports",
    "proxy",
    "routing",
    "localhost",
    "ai-agents",
    "developer-tools"
  ],
  "license": "MIT"
}
